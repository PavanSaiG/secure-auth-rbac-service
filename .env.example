# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
# For local zero-dependency development/testing:
DATABASE_URL=sqlite+aiosqlite:///./auth.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auth_db

# Security & JWT Configuration
# MUST be generated using a cryptographically secure random generator: openssl rand -hex 32
JWT_SECRET_KEY=change-this-in-production-use-strong-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=secure-auth-service
JWT_AUDIENCE=secure-api-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies & CORS
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false # Set to true in production HTTPS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_DEFAULT_PER_MINUTE=60
